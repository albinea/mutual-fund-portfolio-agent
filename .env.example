DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# For a public deployment use https URLs for the reverse-proxy domain(s).
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_BEHIND_HTTPS_PROXY=False
DJANGO_SECURE_SSL_REDIRECT=False
# Enable these only after HTTPS is serving correctly for the public domain.
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_HSTS_PRELOAD=False
DJANGO_ANON_RATE_LIMIT=60/minute
DJANGO_USER_RATE_LIMIT=180/minute

DB_NAME=fundlens
DB_USER=fundlens
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

MYSQL_ROOT_PASSWORD=
QDRANT_URL=http://127.0.0.1:6333
# Optional; use a protected/TLS Qdrant endpoint if configuring an API key.
QDRANT_API_KEY=
