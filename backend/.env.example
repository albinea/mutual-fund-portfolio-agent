DATABASE_URL=postgresql+psycopg://portfolio:change-me@localhost:5432/portfolio
QDRANT_URL=http://127.0.0.1:6333
# Optional; use a protected/TLS Qdrant endpoint if configuring an API key.
QDRANT_API_KEY=
WEB_SEARCH_API_KEY=
# Twelve Data is used only for latest-available market quotes. Never commit a real key.
TWELVE_DATA_API_KEY=
# Legacy alias accepted temporarily by the adapter:
MARKET_DATA_API_KEY=
LOG_LEVEL=INFO
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_TIMEOUT_SECONDS=90
# Used only if the normal answer is withheld, low-confidence, or fails grounding.
OLLAMA_VISION_MODEL=qwen3-vl:235b-cloud
OLLAMA_VISION_MAX_PAGES=3
OLLAMA_VISION_TRIGGER_CONFIDENCE=0.30
OLLAMA_VISION_TIMEOUT_SECONDS=120
# Optional model-specific rates in USD per 1 million provider-reported tokens.
# Leave blank until set to the current Ollama Cloud rates for the chosen models.
OLLAMA_TEXT_INPUT_USD_PER_1M_TOKENS=
OLLAMA_TEXT_OUTPUT_USD_PER_1M_TOKENS=
OLLAMA_VISION_INPUT_USD_PER_1M_TOKENS=
OLLAMA_VISION_OUTPUT_USD_PER_1M_TOKENS=
